rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'abdarhemsheet@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isStaff() {
      return isAdmin() || (
        isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'documenter']
      );
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt', 'createdBy'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'role', 'createdAt', 'createdBy'])
        && data.uid is string
        && data.uid == userId
        && isValidId(data.uid)
        && data.name is string
        && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string
        && data.email.size() >= 3 && data.email.size() <= 254
        && data.role is string
        && data.role in ['admin', 'documenter']
        && data.createdAt is timestamp
        && data.createdBy is string
        && isValidId(data.createdBy);
    }

    function isValidPhotoItem(photo) {
      return photo is string && photo.size() >= 10 && photo.size() <= 350000;
    }

    function isValidPhotosList(photos, photoCount) {
      return photos is list
        && photoCount is int
        && photoCount == photos.size()
        && photos.size() >= 0 && photos.size() <= 3
        && (photos.size() < 1 || isValidPhotoItem(photos[0]))
        && (photos.size() < 2 || isValidPhotoItem(photos[1]))
        && (photos.size() < 3 || isValidPhotoItem(photos[2]));
    }

    function isValidMosque(data) {
      return data.keys().hasAll([
          'officialName', 'commonName', 'locality', 'landmark', 'notes',
          'mapsUrl', 'lat', 'lng', 'accuracy', 'photos', 'photoCount',
          'createdBy', 'createdByName', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'officialName', 'commonName', 'locality', 'landmark', 'notes',
          'mapsUrl', 'lat', 'lng', 'accuracy', 'photos', 'photoCount',
          'createdBy', 'createdByName', 'createdAt', 'updatedAt', 'updatedBy'
        ])
        && data.officialName is string
        && data.officialName.size() >= 1 && data.officialName.size() <= 150
        && data.commonName is string
        && data.commonName.size() >= 0 && data.commonName.size() <= 150
        && data.locality is string
        && data.locality.size() >= 1 && data.locality.size() <= 100
        && data.landmark is string
        && data.landmark.size() >= 0 && data.landmark.size() <= 200
        && data.notes is string
        && data.notes.size() >= 0 && data.notes.size() <= 500
        && data.mapsUrl is string
        && data.mapsUrl.size() >= 25 && data.mapsUrl.size() <= 150
        && data.mapsUrl.matches('^https://www\\.google\\.com/maps\\?q=-?[0-9]+(\\.[0-9]+)?,-?[0-9]+(\\.[0-9]+)?$')
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100000
        && isValidPhotosList(data.photos, data.photoCount)
        && data.createdBy is string && isValidId(data.createdBy)
        && data.createdByName is string
        && data.createdByName.size() >= 1 && data.createdByName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedBy is string && isValidId(data.updatedBy);
    }

    // --- /users Collection (PII isolated to owner & admin) ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && isAdmin();

      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().createdBy == request.auth.uid
        && (
          isAdmin()
          || (isBootstrappedAdmin() && isOwner(userId) && incoming().role == 'admin')
        );

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'email']);

      allow delete: if isSignedIn() && isValidId(userId) && isAdmin() && !isOwner(userId);
    }

    // --- /mosques Collection ---
    match /mosques/{mosqueId} {
      allow get: if isSignedIn() && isValidId(mosqueId) && isStaff();
      allow list: if isSignedIn() && isStaff();

      allow create: if isSignedIn()
        && isValidId(mosqueId)
        && isValidMosque(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isStaff();

      allow update: if isSignedIn()
        && isValidId(mosqueId)
        && isValidMosque(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdByName == existing().createdByName
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().updatedBy == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'officialName', 'commonName', 'locality', 'landmark', 'notes',
          'mapsUrl', 'lat', 'lng', 'accuracy', 'photos', 'photoCount',
          'updatedAt', 'updatedBy'
        ])
        && (
          isAdmin()
          || (existing().createdBy == request.auth.uid && isStaff())
        );

      allow delete: if isSignedIn()
        && isValidId(mosqueId)
        && (
          isAdmin()
          || (existing().createdBy == request.auth.uid && isStaff())
        );
    }
  }
}
